<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>TaskbarMonitor</AssemblyName>
    <RootNamespace>TaskbarMonitor</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
    <NuGetAudit>false</NuGetAudit>
    <Version>1.0.0</Version>
    <Product>TaskBar Monitor</Product>
    <AssemblyTitle>TaskBar Monitor</AssemblyTitle>
    <Description>Загрузка процессора, памяти и видеокарты на панели задач</Description>
    <Copyright>Идея — Kil0bit System Monitor (MIT)</Copyright>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

</Project>
