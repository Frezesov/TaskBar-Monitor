<UserControl x:Class="TaskbarMonitor.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TaskbarMonitor.Controls"
             x:Name="Root">
    <Grid>
        <ToggleButton x:Name="Toggle" Padding="8,5,10,5" HorizontalContentAlignment="Left" MinWidth="136"
                      AutomationProperties.Name="{Binding Caption, ElementName=Root}">
            <StackPanel Orientation="Horizontal">
                <Border Width="18" Height="18" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                        Background="{Binding SwatchBrush, ElementName=Root}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"
                           Text="{Binding Caption, ElementName=Root}" />
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding Hex, ElementName=Root}" />
                <controls:Glyph Margin="10,1,0,0" VerticalAlignment="Center" FontSize="10" Text="&#xE70D;"
                                FontFamily="{StaticResource IconFontFamily}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="Flyout" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}">
            <Border Padding="12" CornerRadius="8" BorderThickness="1" Margin="0,0,8,8"
                    Background="{DynamicResource FlyoutBackground}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.25" Direction="270" />
                </Border.Effect>
                <StackPanel Width="272">
                    <TextBlock Text="Для текста" FontSize="12" Margin="2,0,0,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ItemsControl x:Name="TextSwatches" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SwatchButton}" Background="{Binding}" ToolTip="{Binding Color}"
                                        Click="OnSwatchClick" AutomationProperties.Name="{Binding Color}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Цвета Windows" FontSize="12" Margin="2,10,0,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ItemsControl x:Name="WindowsSwatches" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SwatchButton}" Background="{Binding}" ToolTip="{Binding Color}"
                                        Click="OnSwatchClick" AutomationProperties.Name="{Binding Color}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HEX" VerticalAlignment="Center" Margin="2,0,10,0" FontSize="12.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="HexBox" Grid.Column="1" KeyDown="OnHexKeyDown" LostFocus="OnHexCommit"
                                 AutomationProperties.Name="Цвет в формате HEX" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
