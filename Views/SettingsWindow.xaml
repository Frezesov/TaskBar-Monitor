<Window x:Class="TaskbarMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TaskbarMonitor.Controls"
        Title="TaskBar Monitor"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1000" Height="780" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="12,20,10,14">
            <StackPanel DockPanel.Dock="Bottom">
                <Border Height="1" Margin="4,8,4,8" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Button Command="{Binding ExitCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="14,9"
                        AutomationProperties.Name="Выйти из программы">
                    <StackPanel Orientation="Horizontal">
                        <controls:Glyph Text="&#xE7E8;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                                        VerticalAlignment="Center" />
                        <TextBlock Text="Выйти из программы" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ListBox x:Name="Nav" ItemContainerStyle="{StaticResource NavItem}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyboardNavigation.TabNavigation="Once"
                     AutomationProperties.Name="Разделы настроек"
                     SelectionChanged="OnNavigate">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <controls:Glyph Text="{Binding Glyph}" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                                            VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Title}" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Content layer, like the Windows Settings app -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
                <ContentControl x:Name="PageHost" Margin="{StaticResource PagePadding}" MaxWidth="860"
                                Focusable="False" IsTabStop="False" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
