<!-- Styles derived from the Fluent control styles. Merged by each page (not App.xaml): Fluent's implicit
     styles are only in the application resources once the app has started, which StaticResource needs. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SettingsCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="DisplayMemberPath" Value="Text" />
        <Setter Property="SelectedValuePath" Value="Value" />
    </Style>

    <Style x:Key="SettingsSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
    </Style>

</ResourceDictionary>
